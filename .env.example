# ---------------------------------------------------------------------------
# Copy this file to `.env` and paste your two Supabase values in.
#
# Where to find them:
#   Supabase dashboard -> your project -> Project Settings -> API
#     * "Project URL"          -> VITE_SUPABASE_URL
#     * "anon" / "public" key  -> VITE_SUPABASE_ANON_KEY
#
# The anon key is the PUBLIC key and is safe to ship in a browser app — row
# level security (see supabase/schema.sql) is what protects the data.
# NEVER put the `service_role` key in here; it bypasses every security rule.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# If these are left blank the app still runs, but in "offline / local mode":
# accounts and progress are kept in this browser only. See SETUP.md.
